<html metal:use-macro="here/main_template/macros/master"
      i18n:domain="slc.mailrouter"
>
  <body>
    <div id="content-core"
         metal:fill-slot="main"
    >
      <h1 i18n:translate="add_mailroute">Configure Mail Route</h1>

      <form class="validate"
            action="@@add-mailroute"
            method="post"
            tal:define="
              errors python:request.get('errors', {});
            "
      >
        <dl class="portalMessage error"
            tal:condition="errors"
        >
          <dt i18n:translate="">Error</dt>
          <dd tal:content="errors/name">Something went wrong</dd>
        </dl>
        <fieldset class="concise">
          <label for="name">
            <tal:i18n i18n:translate="">Friendly Name</tal:i18n>
            <sup class="required">*</sup>

            <input class="required"
                   name="name"
                   type="text"
                   tal:attributes="
                     value request/name|view/friendlyname|nothing;
                   "
            />
          </label>
        </fieldset>

        <input name="form.submitted"
               type="hidden"
               value="1"
        />
        <input name="redirect"
               type="hidden"
               tal:attributes="
                 value here/absolute_url;
               "
        />
        <fieldset>
          <input name="form.button.Save"
                 type="submit"
                 value="Save"
                 xclass="context"
                 i18n:attributes="value"
          />
        </fieldset>
      </form>
    </div>
  </body>
</html>
