<html metal:use-macro="context/prefs_main_template/macros/master"
      i18n:domain="slc.mailrouter"
>
  <body>
    <div id="content"
         metal:fill-slot="prefs_configlet_main"
         tal:define="
           dummy view/update;
         "
    >
      <h1 i18n:translate="list_mailroutes">Mail Routes</h1>
      <div tal:define="
             batch view/folder_mappings;
           ">
        <form method="post"
              tal:condition="batch"
              tal:attributes="
                action string:${context/absolute_url}/@@manage-mailrouter;
              "
        >
          <table class="listing">
            <tr>
              <th i18n:translate="">Friendly name</th>
              <th i18n:translate="">Target</th>
              <th i18n:translate="">Delete</th>
            </tr>
            <tr tal:repeat="mapping batch">
              <td tal:content="python: mapping[0]">name</td>
              <td>
                <a tal:content="python: mapping[1]"
                   tal:attributes="
                     href python:'%s/resolveuid/%s' % (context.absolute_url(), mapping[1]);
                   "
                >target</a>
              </td>
              <td>
                <label class="pat-checklist">
                  <input name="remove:list"
                         type="checkbox"
                         tal:attributes="
                           value python:mapping[1];
                         "
                  />
                </label>
              </td>
            </tr>
          </table>
          <input class="context"
                 type="submit"
                 value="Remove routes"
                 i18n:attributes="value"
          />
          <div metal:use-macro="context/batch_macros/macros/navigation"></div>
        </form>
        <p tal:condition="not:batch"
           i18n:translate=""
        >No routes configured</p>
      </div>

    </div>
  </body>
</html>
